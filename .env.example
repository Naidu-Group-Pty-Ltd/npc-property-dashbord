# --- Server-side vendor secrets (Supabase Edge Function secrets, NEVER VITE_) ---
# Anything prefixed VITE_ is inlined into the browser bundle by Vite and is
# therefore public. Vendor keys belong in the Supabase project's function
# secrets instead:
#
#   supabase secrets set GOOGLE_FONTS_API_KEY=...
#
# GOOGLE_FONTS_API_KEY backs the `google-fonts-catalog` edge function, which is
# the only thing that may hold it. Template Builder's font picker previously
# called googleapis.com from the browser with this key written into
# src/hooks/useGoogleFonts.ts, so it shipped in every build. Without the secret
# set, the picker falls back to its curated list — degraded, not broken.

# --- MCP tooling (local dev only, NOT bundled into the app) ---
# API key for the @21st-dev/magic MCP server referenced in .mcp.json as ${MAGIC_API_KEY}.
# Generate one at https://21st.dev/magic/console, then copy this file to .env.local and
# fill in the value (or export MAGIC_API_KEY in your shell before starting Claude Code).
# Leave blank here — never commit a real key.
MAGIC_API_KEY=""

# API key for the hosted `21st` HTTP MCP server referenced in .mcp.json as
# ${TWENTY_FIRST_API_KEY}. Sent as the `x-api-key` request header. Generate one at
# https://21st.dev/magic/console, then copy this file to .env.local and fill in the
# value (or export TWENTY_FIRST_API_KEY in your shell before starting Claude Code).
# Leave blank here — never commit a real key.
TWENTY_FIRST_API_KEY=""
